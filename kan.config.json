{
  "$schema": "https://kanban-as-code.dev/schema/config.json",
  "version": "1.1.0",
  "kanbanRoot": "./kanban",
  "docsRoot": "./docs",
  "outputDir": ".kan",
  "collections": {
    "architecture-reference": {
      "path": "kanban/architecture-reference.md",
      "type": "architecture-reference"
    },
    "strategy-current": {
      "path": "kanban/Strategy-Current.md",
      "type": "strategy-current"
    },
    "strategic-execution-spec": {
      "path": "kanban/strategic-execution-spec.md",
      "type": "strategic-execution-spec"
    },
    "initiatives": {
      "path": "kanban/roadmap/initiatives",
      "type": "initiative"
    },
    "docs": {
      "path": "docs/README.md",
      "type": "generic"
    }
  },
  "evolution": ["proposed", "ready", "in-progress", "blocked", "review", "done", "deferred", "cancelled", "archived"],
  "cleanup": {
    "staleDays": 90,
    "duplicateThreshold": 0.75
  }
}
